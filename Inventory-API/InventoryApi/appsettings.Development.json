{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
      "InventoryDb": "Server=localhost;Database=InventoryDb;User Id=defaultAdmin;Password=NewStrongPassword;MultipleActiveResultSets=true;TrustServerCertificate=True",
      "KurrentDb": "kurrentdb://localhost:2113?tls=false&tlsVerifyCert=false",
      // "KurrentDb": "kurrentdb://username:password@localhost:2113?tls=false&tlsVerifyCert=false",
